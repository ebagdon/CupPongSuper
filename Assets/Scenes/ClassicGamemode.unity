--- !u!114 &1980555967
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1980555965}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59e2d407b57e26b4eaead22dc2b97584, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  English_Text: WHEN YOU PUT THE BALL IN A CUP, THERE IS A 50% CHANCE OF GETTING
    A MISS BACK.
  French_Text: QUAND VOUS PLACEZ LA BALLE DANS UNE TASSE, IL Y A 50 % DE CHANCES
    D'OBTENIR UN MISS BACK.
  German_Text: "WENN SIE DEN BALL IN EINEN BECHER F\xDCHREN, GIBT ES EINE 50 % CHANCE,
    EINEN MISS BACK ZU BEKOMMEN."
  Spanish_Text: CUANDO COLOCAS LA PELOTA EN UNA TAZA, HAY UN 50% DE POSIBILIDADES
    DE RETIRAR UN FALLO.
  Swedish_Text: "N\xC4R DU L\xC4TTAR BOLLEN I EN B\xC5G FINNS DET 50 % RANSKA ATT
    F\xC5 EN FR\xD6KEN TILLBAKA."
  Chinese_Simplified_Text: "\u5F53\u4F60\u628A\u7403\u653E\u5728\u676F\u5B50\u91CC\u65F6\uFF0C\r\n\u6709
    50% \u7684\u673A\u4F1A\r\n\u5F97\u5230\u4E00\u4E2A\u5C0F\u59D0\u56DE\u6765\u3002"
  Hindi_Text: "\u091C\u092C \u0906\u092A \u0917\u0947\u0902\u0926 \u0915\u094B \u0915\u092A
    \u092E\u0947\u0902 \u0921\u093E\u0932\u0924\u0947 \u0939\u0948\u0902, \u0924\u094B
    \u092E\u093F\u0938 \u092C\u0948\u0915 \u0939\u094B\u0928\u0947 \u0915\u0940 50%
    \u0938\u0902\u092D\u093E\u0935\u0928\u093E \u0939\u094B\u0924\u0940 \u0939\u0948\u0964"
  englishLineSpacing: 0.69
  frenchLineSpacing: 0.74
  germanLineSpacing: 0.74
  spanishLineSpacing: 0.74
  swedishLineSpacing: 0.86
  chineseSimplifiedLineSpacing: 0.76
  hindiLineSpacing: 0.9
