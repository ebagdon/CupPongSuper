  m_Script: {fileID: 11500000, guid: 59e2d407b57e26b4eaead22dc2b97584, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  English_Text: IF YOU LEAVE THIS ROUND NOW, COINS EARNED FROM THIS ROUND WILL BE
    LOST!
  French_Text: "SI VOUS QUITTEZ CE TOUR MAINTENANT, LES PI\xC8CES GAGN\xC9ES DE CE
    TOUR SERONT PERDUES !"
  German_Text: "WENN SIE DIESE RUNDE JETZT VERLASSEN, GEHEN DIE IN DIESER RUNDE VERDIENTEN
    M\xDCNZEN VERLOREN!"
  Spanish_Text: "\xA1SI DEJA ESTA RONDA AHORA, LAS MONEDAS GANADAS DE ESTA RONDA
    SE PERDER\xC1N!"
  Swedish_Text: "OM DU L\xC5R DEN H\xC4R RUNDAN NU, KOMMER MYNT SOM TJ\xC4NNAS FR\xC5N
    DENNA RUND F\xD6RSLUTADE!"
  Chinese_Simplified_Text: "\u5982\u679C\u4F60\u79BB\u5F00\u8FD9\u4E00\u8F6E\r\n\u73B0\u5728\uFF0C\u4ECE\u4E2D\u8D5A\u53D6\u7684\u786C\u5E01\r\n\u8FD9\u4E00\u8F6E\u5C06\u4F1A\u5931\u8D25\uFF01"
  Hindi_Text: "\u092F\u0926\u093F \u0906\u092A \u0907\u0938 \u0926\u094C\u0930 \u0915\u094B
    \u091B\u094B\u0921\u093C\u0924\u0947 \u0939\u0948\u0902\r\n\u0905\u092C, \u0938\u0947
    \u0915\u092E\u093E\u090F \u0917\u090F \u0938\u093F\u0915\u094D\u0915\u0947\r\n\u092F\u0939
    \u0926\u094C\u0930 \u0916\u094B \u091C\u093E\u090F\u0917\u093E!"
  englishLineSpacing: 0.7
  frenchLineSpacing: 0.85
  germanLineSpacing: 0.73
  spanishLineSpacing: 0.79
