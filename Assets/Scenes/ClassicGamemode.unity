--- !u!114 &2031038464
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2031038462}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59e2d407b57e26b4eaead22dc2b97584, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  English_Text: 'CLASSIC CUP PONG PUT THE BALL IN THE CUPS AND GET REWARDED COINS,

    MISS
    AND YOU WILL LOSE COINS.'
  French_Text: "\rCLASSIC CUP PONG METTRE LA BALLE DANS LES TASSES ET OBTENIR DES
    PI\xC8CES R\xC9COMPENS\xC9ES, MISS ET VOUS PERDREZ DES PI\xC8CES."
  German_Text: "KLASSISCHES CUP PONG LEGEN SIE DEN BALL IN DIE BECHER UND ERHALTEN
    SIE BELOHNE M\xDCNZEN, VERPASSEN SIE UND SIE VERLIEREN M\xDCNZEN."
  Spanish_Text: "CLASSIC CUP PONG PON LA PELOTA EN LAS TAZAS Y OBT\xC9N MONEDAS DE
    RECOMPENSA, FALLAS Y PERDER\xC1S MONEDAS."
  Swedish_Text: "CLASSIC CUP PONG S\xC4TT BOLLEN I CUPPEN OCH F\xC5 BEL\xD6NADE MYNT,
    FR\xD6KEN OCH DU KOMMER ATT F\xD6RLORA MYNT."
  Chinese_Simplified_Text: "\rCLASSIC CUP PONG \u5C06\u7403\u653E\u5165\u676F\u5B50\u5E76\u83B7\u5F97\u5956\u52B1\u786C\u5E01\uFF0C\r\n\u5C0F\u59D0\uFF0C\u60A8\u5C06\u5931\u53BB\u786C\u5E01\u3002"
  Hindi_Text: "\r\u0915\u094D\u0932\u093E\u0938\u093F\u0915 \u0915\u092A \u092A\u094B\u0902\u0917
    \u0917\u0947\u0902\u0926 \u0915\u094B \u0915\u092A \u092E\u0947\u0902 \u0921\u093E\u0932\u0947\u0902
    \u0914\u0930 \u092A\u0941\u0930\u0938\u094D\u0915\u0943\u0924 \u0938\u093F\u0915\u094D\u0915\u0947
    \u092A\u094D\u0930\u093E\u092A\u094D\u0924 \u0915\u0930\u0947\u0902, \u092E\u093F\u0938
    \u0915\u0930\u0947\u0902 \u0914\u0930 \u0906\u092A \u0938\u093F\u0915\u094D\u0915\u0947
    \u0916\u094B \u0926\u0947\u0902\u0917\u0947\u0964"
  englishLineSpacing: 0.69
  frenchLineSpacing: 0.84
  germanLineSpacing: 0.72
  spanishLineSpacing: 0.87
  swedishLineSpacing: 0.84
  chineseSimplifiedLineSpacing: 0.72
  hindiLineSpacing: 0.96
