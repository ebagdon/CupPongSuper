--- !u!114 &2015678837
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2015678833}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59e2d407b57e26b4eaead22dc2b97584, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  English_Text: WHEN THE ORANGE BOARDS ABOVE THE CUPS ARE ACTIVE YOU MUST SHOOT THE
    BALL OFF OF ONE OF THE ORANGE BOARDS AND INTO A CUP. IF IT GOES STRAIGHT IN IT
    WILL NOT COUNT.
  French_Text: "LORSQUE LES PLANCHES ORANGES AU-DESSUS DES TASSES SONT ACTIVES, VOUS
    DEVEZ TIRER LA BALLE SUR L'UNE DES PLANCHES ORANGE ET DANS UNE TASSE. SI \xC7A
    VA TOUT DROIT, \xC7A NE COMPTERA PAS."
  German_Text: "WENN DIE ORANGE BRETT \xDCBER DEN BECHERN AKTIV SIND, M\xDCSSEN SIE
    DEN BALL VON EINEM DER ORANGE BRETT IN EINEN BECHER SCHIESSEN. WENN ES GERADE
    IN GEHT, WIRD ES NICHT Z\xC4HLEN."
  Spanish_Text: "CUANDO LOS TABLEROS NARANJAS SOBRE LAS COPAS EST\xC9N ACTIVOS, DEBE
    LANZAR LA PELOTA DESDE UNO DE LOS TABLEROS NARANJAS HACIA UNA COPA. SI VA DERECHO
    ADENTRO NO CONTAR\xC1."
  Swedish_Text: "N\xC4R DE ORANGE TAVLARNA OVAN KOPPEN \xC4R AKTIVA M\xC5STE DU SKJUTA
    BOLLEN FR\xC5N N\xC5GOT AV DE ORANGE TAVLARNA OCH I EN BOK. OM DET G\xC5R RAKT
    IN KOMMER DET INTE att R\xC4KNAS."
  Chinese_Simplified_Text: "\u5F53\u676F\u5B50\u4E0A\u65B9\u7684\u6A59\u8272\u677F\u5904\u4E8E\u6D3B\u52A8\u72B6\u6001\u65F6\r\n\u60A8\u5FC5\u987B\u5C06\u7403\u4ECE\u5176\u4E2D\u4E00\u4E2A\u6A59\u8272\u677F\u4E0A\u5C04\u5165\u676F\u5B50\u4E2D\u3002\r\n\u5982\u679C\u5B83\u76F4\u63A5\u8FDB\u5165\u5B83\u5C31\u4E0D\u7B97\u6570\u3002"
  Hindi_Text: "\u091C\u092C \u0915\u092A \u0915\u0947 \u090A\u092A\u0930 \u0911\u0930\u0947\u0902\u091C
    \u092C\u094B\u0930\u094D\u0921 \u0938\u0915\u094D\u0930\u093F\u092F \u0939\u094B\u0902\r\n\u0906\u092A\u0915\u094B
    \u0911\u0930\u0947\u0902\u091C \u092C\u094B\u0930\u094D\u0921 \u092E\u0947\u0902
    \u0938\u0947 \u0915\u093F\u0938\u0940 \u090F\u0915 \u0915\u0940 \u0917\u0947\u0902\u0926
    \u0915\u094B \u090F\u0915 \u0915\u092A \u092E\u0947\u0902 \u0936\u0942\u091F
    \u0915\u0930\u0928\u093E \u0939\u094B\u0917\u093E\u0964\r\n\u0905\u0917\u0930
    \u092F\u0939 \u0938\u0940\u0927\u0947 \u0907\u0938\u092E\u0947\u0902 \u091C\u093E\u0924\u093E
    \u0939\u0948 \u0924\u094B \u0907\u0938\u0915\u0940 \u0917\u0923\u0928\u093E \u0928\u0939\u0940\u0902
    \u0915\u0940 \u091C\u093E\u090F\u0917\u0940\u0964"
  englishLineSpacing: 0.58
  frenchLineSpacing: 0.7
  germanLineSpacing: 0.7
  spanishLineSpacing: 0.8
  swedishLineSpacing: 0.8
  chineseSimplifiedLineSpacing: 0.78
  hindiLineSpacing: 0.85
