--- !u!114 &685188657
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 685188655}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59e2d407b57e26b4eaead22dc2b97584, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  English_Text: WHEN A RAMP APPEARS IN FRONT OF THE CUPS YOU MUST SIMPLY SHOOT THE
    BALL OFF THE RAMP AND INTO THE CUPS.
  French_Text: "QUAND UNE RAMPE APPARA\xCET DEVANT LES TASSES, VOUS DEVEZ SIMPLEMENT
    TIRER LA BALLE DEPUIS LA RAMPE ET DANS LES TASSES."
  German_Text: "WENN EINE RAMPE VOR DEN BECHERN ERSCHEINT, M\xDCSSEN SIE DEN BALL
    EINFACH VON DER RAMPE IN DIE BECHER SCHIESSEN."
  Spanish_Text: "\rCUANDO APARECE UNA RAMPA DELANTE DE LAS COPAS, SIMPLEMENTE DEBE
    LANZAR LA PELOTA DESDE LA RAMPA HACIA LAS COPAS."
  Swedish_Text: "N\xC4R EN RAMP VISAS FRAMF\xD6R KOPPEN M\xC5STE DU HELT ENKELT SKJUTA
    BOLLEN FR\xC5N RAMPEN OCH IN I KUPPEN."
  Chinese_Simplified_Text: "\u5F53\u676F\u5B50\u524D\u9762\u51FA\u73B0\u659C\u5761\u65F6\r\n\u60A8\u5FC5\u987B\u7B80\u5355\u5730\u5C06\u7403\u4ECE\u659C\u5761\u4E0A\u5C04\u5165\u676F\u4E2D\u3002"
  Hindi_Text: "\u091C\u092C \u0915\u092A \u0915\u0947 \u0938\u093E\u092E\u0928\u0947
    \u090F\u0915 \u0930\u0948\u0902\u092A \u0926\u093F\u0916\u093E\u0908 \u0926\u0947\u0924\u093E
