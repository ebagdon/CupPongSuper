--- !u!114 &211995973
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 211995971}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59e2d407b57e26b4eaead22dc2b97584, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  English_Text: WHEN THERE ARE TARGETS ACTIVE ABOVE THE CUPS YOU MUST SHOOT THE BALL
    INTO ONE OF THE CUPS WITH THE TARGETS ABOVE, OTHERWISE IT WILL NOT COUNT.
  French_Text: LORSQU'IL Y A DES CIBLES ACTIVES AU-DESSUS DES TASSES, VOUS DEVEZ
    TIRER LA BALLE DANS L'UNE DES TASSES AVEC LES CIBLES AU-DESSUS, SINON ELLE NE
    COMPTERA PAS.
  German_Text: "WENN \xDCBER DEN BECHERN TARGETS AKTIV SIND, M\xDCSSEN SIE DEN BALL
    IN EINEN DER BECHER MIT DEN OBEREN TARGETS SCHIESSEN, SONST Z\xC4HLT ES NICHT."
  Spanish_Text: "CUANDO HAY DIANAS ACTIVAS ENCIMA DE LAS COPAS DEBE LANZAR LA PELOTA
    EN UNA DE LAS COPAS CON LAS DIANAS ARRIBA, DE LO CONTRARIO NO CONTAR\xC1."
  Swedish_Text: "N\xC4R DET FINNS M\xC5L AKTIVA OVAN KUPPEN M\xC5STE DU SKJUTA BOLLEN
    I EN AV KUPPEN MED M\xC5LEN OVAN, ANNARS R\xC4KNAS DET INTE."
  Chinese_Simplified_Text: "\r\u5F53\u676F\u5B50\u4E0A\u65B9\u6709\u6D3B\u52A8\u7684\u76EE\u6807\u65F6\r\n\u60A8\u5FC5\u987B\u5C06\u7403\u5C04\u5165\u5177\u6709\u4E0A\u8FF0\u76EE\u6807\u7684\u676F\u5B50\u4E4B\u4E00\uFF0C\r\n\u5426\u5219\u5C06\u4E0D\u8BA1\u7B97\u5728\u5185\u3002"
  Hindi_Text: "\r\u091C\u092C \u0915\u092A \u0915\u0947 \u090A\u092A\u0930 \u0932\u0915\u094D\u0937\u094D\u092F
    \u0938\u0915\u094D\u0930\u093F\u092F \u0939\u094B\u0902\r\n\u0906\u092A\u0915\u094B
    \u090A\u092A\u0930 \u0926\u093F\u090F \u0917\u090F \u0932\u0915\u094D\u0937\u094D\u092F\u094B\u0902
    \u0915\u0947 \u0938\u093E\u0925 \u0915\u093F\u0938\u0940 \u090F\u0915 \u0915\u092A
    \u092E\u0947\u0902 \u0917\u0947\u0902\u0926 \u0915\u094B \u0936\u0942\u091F \u0915\u0930\u0928\u093E
    \u0939\u094B\u0917\u093E,\r\n\u0905\u0928\u094D\u092F\u0925\u093E \u0907\u0938\u0915\u0940
    \u0917\u0923\u0928\u093E \u0928\u0939\u0940\u0902 \u0915\u0940 \u091C\u093E\u090F\u0917\u0940\u0964"
  englishLineSpacing: 0.58
  frenchLineSpacing: 0.68
  germanLineSpacing: 0.7
  spanishLineSpacing: 0.81
  swedishLineSpacing: 0.8
  chineseSimplifiedLineSpacing: 0.8
  hindiLineSpacing: 0.9
