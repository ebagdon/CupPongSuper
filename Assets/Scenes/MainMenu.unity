  m_Script: {fileID: 11500000, guid: 59e2d407b57e26b4eaead22dc2b97584, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  English_Text: CUP PONG, EXCEPT EVERY TIME YOU THROW THE BALL AN EVENT HAPPENS!
  French_Text: "\rCUP PONG, SAUF A CHAQUE FOIS QUE VOUS LANCEZ LA BALLE, UN EVENEMENT
    SE PRODUIT !"
  German_Text: CUP PONG, AUSSER JEDES MAL, WENN SIE DEN BALL WERFEN, PASSIERT EIN
    EREIGNIS!
  Spanish_Text: "CUP PONG, \xA1EXCEPTO CADA VEZ QUE TIRAS LA PELOTA SUCEDE UN EVENTO!"
  Swedish_Text: "CUP PONG, UTOM VARJE G\xC5NG DU KASTAR BOLLEN H\xC4NDER EN H\xC4NDELSE!"
  Chinese_Simplified_Text: "CUP PONG\uFF0C\u9664\u4E86\u6BCF\u6B21\u4F60\u6254\u7403\r\n\u4E00\u4E2A\u4E8B\u4EF6\u53D1\u751F\u4E86\uFF01"
  Hindi_Text: "\u0915\u092A \u092A\u094B\u0902\u0917, \u0938\u093F\u0935\u093E\u092F
    \u0939\u0930 \u092C\u093E\u0930 \u091C\u092C \u0906\u092A \u0917\u0947\u0902\u0926
    \u092B\u0947\u0902\u0915\u0924\u0947 \u0939\u0948\u0902 \u090F\u0915 \u0918\u091F\u0928\u093E
    \u0939\u094B\u0924\u0940 \u0939\u0948!"
  englishLineSpacing: 0.69
  frenchLineSpacing: 0.69
  germanLineSpacing: 0.69
  spanishLineSpacing: 0.69
  swedishLineSpacing: 0.94
  chineseSimplifiedLineSpacing: 0.69
  hindiLineSpacing: 0.94
