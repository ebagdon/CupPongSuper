--- !u!114 &1055710464
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1055710462}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59e2d407b57e26b4eaead22dc2b97584, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  English_Text: THE FURTHER YOU PULL BACK, THE FURTHER THE BALL GOES. YOU HAVE A
    SECOND TO THROW THE BALL.
  French_Text: "PLUS VOUS TIREZ EN ARRI\xC8RE, PLUS LA BALLE VA LOIN. VOUS AVEZ UNE
    SECONDE POUR LANCER LA BALLE."
  German_Text: "JE WEITER SIE ZUR\xDCCKZIEHEN, DESTO WEITER FLIEGT DER BALL. SIE
    HABEN EINE SEKUNDE, UM DEN BALL ZU WERFEN."
  Spanish_Text: "CUANTO M\xC1S SE RETIRA, M\xC1S LEJOS VA LA PELOTA. TIENES UN SEGUNDO
    PARA LANZAR LA PELOTA."
  Swedish_Text: "JU L\xC4NGRE DU DRAR TILLBAKA, DEsto L\xC4NGRE G\xC5R BOLLEN. DU
    HAR EN SEKUND P\xC5 ATT KASTA BOLLEN."
  Chinese_Simplified_Text: "\u8FDB\u4E00\u6B65\r\n\u4F60\u5411\u540E\u9000\uFF0C\r\n\u7403\u8D70\u5F97\u8D8A\u8FDC\u3002\u4F60\u6709\u4E00\u4E2A\r\n\u7B2C\u4E8C\u6B21\r\n\u6254\u7403\u3002"
  Hindi_Text: "\u0906\u092A \u091C\u093F\u0924\u0928\u093E \u0906\u0917\u0947 \u092A\u0940\u091B\u0947
    \u0916\u0940\u0902\u091A\u0947\u0902\u0917\u0947, \u0917\u0947\u0902\u0926 \u0909\u0924\u0928\u0940
    \u0939\u0940 \u0906\u0917\u0947 \u091C\u093E\u090F\u0917\u0940\u0964 \u0906\u092A\u0915\u0947
    \u092A\u093E\u0938 \u0917\u0947\u0902\u0926 \u092B\u0947\u0902\u0915\u0928\u0947
    \u0915\u0947 \u0932\u093F\u090F \u090F\u0915 \u0938\u0947\u0915\u0902\u0921 \u0939\u0948\u0964"
  englishLineSpacing: 0.63
  frenchLineSpacing: 0.8
  germanLineSpacing: 0.7
  spanishLineSpacing: 0.8
  swedishLineSpacing: 0.9
  chineseSimplifiedLineSpacing: 0.71
  hindiLineSpacing: 0.83
