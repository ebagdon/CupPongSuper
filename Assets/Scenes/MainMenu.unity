  m_Script: {fileID: 11500000, guid: 59e2d407b57e26b4eaead22dc2b97584, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  English_Text: SORRY, YOU DON'T HAVE ENOUGH COINS TO BUY THIS SKIN. WOULD YOU LIKE
    TO BUY MORE COINS?
  French_Text: "D\xC9SOL\xC9, VOUS N'AVEZ PAS ASSEZ DE PI\xC8CES POUR ACHETER CETTE
    SKIN. VOULEZ-VOUS ACHETER PLUS DE PI\xC8CES ?"
  German_Text: "ENTSCHULDIGUNG, SIE HABEN NICHT GENUG M\xDCNZEN, UM DIESEN SKIN ZU
    KAUFEN. M\xD6CHTEN SIE MEHR M\xDCNZEN KAUFEN?"
  Spanish_Text: "\rLO SENTIMOS, NO TIENES MONEDAS SUFICIENTES PARA COMPRAR ESTE ASPECTO.
    \xBFQUIERES COMPRAR M\xC1S MONEDAS?"
  Swedish_Text: "TYV\xC4RR, DU HAR INTE TILR\xC4CKLIGT MED MYNT F\xD6R ATT K\xD6PA
    DETTA SKIN. VILL DU K\xD6PA FLERA MYNT?"
  Chinese_Simplified_Text: "\u5BF9\u4E0D\u8D77\uFF0C\u4F60\u6CA1\u6709\u8DB3\u591F\u7684\u786C\u5E01\r\n\u8D2D\u4E70\u8FD9\u6B3E\u76AE\u80A4\u3002\r\n\u4F60\u662F\u5426\u60F3\u8981\r\n\u8D2D\u4E70\u66F4\u591A\u786C\u5E01\uFF1F"
  Hindi_Text: "\u0915\u094D\u0937\u092E\u093E \u0915\u0930\u0947\u0902, \u0906\u092A\u0915\u0947
    \u092A\u093E\u0938 \u0907\u0938 \u0924\u094D\u0935\u091A\u093E \u0915\u094B \u0916\u0930\u0940\u0926\u0928\u0947
    \u0915\u0947 \u0932\u093F\u090F \u092A\u0930\u094D\u092F\u093E\u092A\u094D\u0924
    \u0938\u093F\u0915\u094D\u0915\u0947 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964
    \u0915\u094D\u092F\u093E \u0906\u092A \u0914\u0930 \u0905\u0927\u093F\u0915 \u0938\u093F\u0915\u094D\u0915\u0947
    \u0916\u0930\u0940\u0926\u0928\u093E \u091A\u093E\u0939\u0947\u0902\u0917\u0947?"
  englishLineSpacing: 0.66
  frenchLineSpacing: 0.93
  germanLineSpacing: 0.86
  spanishLineSpacing: 0.9
  swedishLineSpacing: 0.86
  chineseSimplifiedLineSpacing: 0.74
  hindiLineSpacing: 0.92
